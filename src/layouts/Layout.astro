---
import fs from 'node:fs';
import crypto from 'node:crypto';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import config from '../data/config.json';

// public/assets/* is served with an "immutable, max-age=31536000" cache
// header (see public/_headers) -- fine for images, but it means an edit to
// style.css or main.js under the SAME url never reaches a returning
// visitor's browser, or Cloudflare's edge cache, for up to a year. A
// query string built from the file's own content hash gives each edit a
// new URL automatically, busting both caches without any manual version
// bump or Cloudflare purge.
function assetVersion(publicPath: string) {
  try {
    const abs = new URL(`../../public${publicPath}`, import.meta.url);
    const bytes = fs.readFileSync(abs);
    return crypto.createHash('md5').update(bytes).digest('hex').slice(0, 8);
  } catch {
    return Date.now().toString(36);
  }
}
const cssVersion = assetVersion('/assets/css/style.css');
const jsVersion = assetVersion('/assets/js/main.js');

interface Props {
  title_cy: string;
  title_en: string;
  description_cy?: string;
  description_en?: string;
  canonical?: string;
  ogImage?: string;
  pageClass?: string;
}

const {
  title_cy,
  title_en,
  description_cy = config.site.name_cy,
  description_en = config.site.name_en,
  canonical = Astro.url.href,
  ogImage = '/assets/img/village-aerial.jpg',
  pageClass = ''
} = Astro.props;

const siteUrl = config.site.url;
---
<!DOCTYPE html>
<html lang="cy-GB" data-lang="cy">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title_cy} / {title_en} — {config.site.name_cy}</title>
  <meta name="description" content={`${description_cy} | ${description_en}`}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="cy" href={canonical}>
  <link rel="alternate" hreflang="en" href={canonical}>
  <link rel="alternate" hreflang="x-default" href={canonical}>
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">

  <!-- Fonts: preconnect starts the connection as early as possible, and a
       real <link> (rather than a CSS @import) lets the browser discover and
       fetch this in parallel with style.css instead of after it. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Open+Sans:wght@300;400;500;600&display=swap">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={`${title_cy} | ${title_en} — ${config.site.name_cy}`}>
  <meta property="og:description" content={description_en}>
  <meta property="og:image" content={`${siteUrl}${ogImage}`}>
  <meta property="og:locale" content="cy_GB">
  <meta property="og:locale:alternate" content="en_GB">

  <!-- Stylesheets -->
  <link rel="stylesheet" href={`/assets/css/style.css?v=${cssVersion}`}>

  <!-- Pagefind search UI: not needed until someone opens search, so it's
       loaded without blocking the initial render. preload fetches it early
       (still off the critical path); the onload swap then activates it as
       a real stylesheet. noscript covers browsers with JS disabled. -->
  <link rel="preload" href="/pagefind/pagefind-ui.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/pagefind/pagefind-ui.css"></noscript>
</head>
<body class={pageClass}>

  <!-- Skip to content (WCAG 2.2 requirement) -->
  <a href="#main-content" class="skip-link">
    <span lang="cy">Neidio i'r prif gynnwys</span>
    <span lang="en">Skip to main content</span>
  </a>

  <!-- Language toggle bar -->
  <div class="lang-bar" role="navigation" aria-label="Language selection">
    <button class="lang-toggle" onclick="toggleLang()" aria-label="Switch language / Newid iaith">
      <span lang="cy">English</span>
      <span lang="en">Cymraeg</span>
    </button>
  </div>

  <Navigation />

  <!-- data-pagefind-body scopes indexing to just this element, so the
       identical nav/footer text on every page doesn't dilute or blur
       search relevance -- e.g. a search for "contact" should surface the
       Contact page itself rather than tying with every other page that
       also happens to have a "Contact" link in its nav. -->
  <main id="main-content" tabindex="-1" data-pagefind-body>
    <slot />
  </main>

  <Footer />

  <script src={`/assets/js/main.js?v=${jsVersion}`} is:inline></script>
  <script src="/pagefind/pagefind-ui.js" type="module" is:inline></script>
</body>
</html>

<style is:global>
  /* Bilingual show/hide */
  html[data-lang="en"] [lang="cy"] { display: none !important; }
  html:not([data-lang="en"]) [lang="en"] { display: none !important; }

  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--primary);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 0 0 4px 4px;
    font-weight: 600;
    z-index: 9999;
    transition: top 0.2s;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 0;
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  /* Focus visible — WCAG 2.2 */
  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
