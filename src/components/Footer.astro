---
import config from '../data/config.json';
import settings from '../data/site-settings.json';
import councillors from '../data/councillors.json';
import { ROLE_LABELS } from '../data/people-lookups.js';

const { site } = config;
const { council, social } = settings;
const clerkPerson = councillors.people.find(p => p.role === 'clerk' && p.active);
---
<footer>
  <div class="footer-grid">
    <div>
      <p class="fg-title" lang="cy">{site.name_cy}</p>
      <p class="fg-title" lang="en">{site.name_en}</p>
      <p class="fg-meta">
        <span lang="cy">{site.area_cy}</span>
        <span lang="en">{site.area_en}</span><br>
        <span lang="cy">{ROLE_LABELS.clerk.cy}: {clerkPerson?.name}</span>
        <span lang="en">{ROLE_LABELS.clerk.en}: {clerkPerson?.name}</span><br>
        <a href={`mailto:${council.email}`}>{council.email}</a>
      </p>
    </div>

    <div>
      <p class="fg-title" lang="cy">Y Cyngor</p>
      <p class="fg-title" lang="en">The Council</p>
      <ul class="fg-links">
        <li><a href="/the-council/"><span lang="cy">Am y Cyngor</span><span lang="en">About Us</span></a></li>
        <li><a href="/the-council/what-we-spend/"><span lang="cy">Beth Rydym yn ei Wario</span><span lang="en">What We Spend</span></a></li>
        <li><a href="/the-council/grants/"><span lang="cy">Grantiau a Rhoddion</span><span lang="en">Grants &amp; Donations</span></a></li>
      </ul>
    </div>

    <div>
      <p class="fg-title"><span lang="cy">Cyfarfodydd</span><span lang="en">Meetings</span></p>
      <ul class="fg-links">
        <li><a href="/meetings/"><span lang="cy">Dyddiadau</span><span lang="en">Dates</span></a></li>
        <li><a href="/meetings/minutes/"><span lang="cy">Cofnodion</span><span lang="en">Minutes</span></a></li>
        <li><a href="/calendar/"><span lang="cy">Calendr</span><span lang="en">Calendar</span></a></li>
      </ul>
    </div>

    <div>
      <p class="fg-title"><span lang="cy">Dolenni Defnyddiol</span><span lang="en">Useful Links</span></p>
      <ul class="fg-links">
        <li><a href="https://www.conwy.gov.uk" target="_blank" rel="noopener noreferrer">Cyngor Conwy CBC</a></li>
        <li><a href="https://senedd.wales" target="_blank" rel="noopener noreferrer">Senedd Cymru</a></li>
        <li><a href="https://onevoicewales.org.uk" target="_blank" rel="noopener noreferrer">One Voice Wales</a></li>
        <li><a href="/contact/"><span lang="cy">Cysylltu</span><span lang="en">Contact</span></a></li>
        {social.facebook && <li><a href={social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>}
        {social.twitter && <li><a href={social.twitter} target="_blank" rel="noopener noreferrer">Twitter / X</a></li>}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; {new Date().getFullYear()} {site.name_cy} / {site.name_en}</span>
    <span>
      <a href="/privacy/"><span lang="cy">Polisi Preifatrwydd</span><span lang="en">Privacy Policy</span></a>
      &nbsp;|&nbsp;
      <a href="/terms/"><span lang="cy">Telerau Defnydd</span><span lang="en">Terms of Use</span></a>
      &nbsp;|&nbsp;
      <a href="/accessibility/"><span lang="cy">Hygyrchedd</span><span lang="en">Accessibility</span></a>
      &nbsp;|&nbsp;
      <a href="/sitemap.xml">Sitemap</a>
    </span>
  </div>
</footer>
