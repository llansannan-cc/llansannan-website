---
import Layout from '../../layouts/Layout.astro';
import councillors from '../../data/councillors.json';
import { ROLE_LABELS, WARD_LABELS } from '../../data/people-lookups.js';

const allActive = councillors.people
  .filter(p => p.active && p.ward !== 'staff')
  .map(p => ({ ...p, ward_cy: WARD_LABELS[p.ward].cy, ward_en: WARD_LABELS[p.ward].en }));
---
<Layout title_cy="Cofrestru Buddiannau" title_en="Register of Interests">
  <div class="page-banner"><h1><span lang="cy">Cofrestru Buddiannau</span><span lang="en">Register of Interests</span></h1></div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <a href="/councillors/"><span lang="cy">Cynghorwyr</span><span lang="en">Councillors</span></a> &rsaquo;
    <span lang="cy">Buddiannau</span><span lang="en">Interests</span>
  </div>
  <div class="site-wrap"><div class="content" data-pagefind-body>
    <h2 class="sh"><span lang="cy">Cofrestr Buddiannau Aelodau</span><span lang="en">Members' Register of Interests</span></h2><hr class="sh-rule">

    <p lang="cy">Mae'n ofynnol i bob cynghorydd ddatgan eu buddiannau personol a chofnodi'r datganiadau a wneir mewn cyfarfodydd dan y Côd Ymddygiad.</p>
    <p lang="en">Every councillor must declare their personal interests, and declarations made at meetings are recorded, under the Code of Conduct.</p>

    <div class="minutes-list" style="margin-top:1.5rem">
      <div class="minutes-item">
        <div>
          <strong><span lang="cy">Cofrestr Datganiadau Diddordeb Aelodau</span><span lang="en">Register of Members' Declarations of Interest</span></strong>
          <div class="fg-meta"><span lang="cy">Pob aelod, un ddogfen (2017–2026)</span><span lang="en">All members in one document (2017–2026)</span></div>
        </div>
        <div class="doc-links">
          <a href="/documents/policies/register-of-members-interests.pdf" class="doc-link pdf">
            <span lang="cy">Lawrlwytho (dwyieithog) — PDF</span><span lang="en">Download (bilingual) — PDF</span>
          </a>
        </div>
      </div>
    </div>

    <h3 class="sub-sh"><span lang="cy">Aelodau cyfredol</span><span lang="en">Current members</span></h3>
    <ul class="ym-plain" style="margin:.5rem 0 1rem 1.5rem;line-height:1.9">
      {allActive.map(c => (
        <li>
          <strong>{c.name}</strong>
          {c.role !== 'councillor' && (
            <> — <em><span lang="cy">{ROLE_LABELS[c.role].cy}</span><span lang="en">{ROLE_LABELS[c.role].en}</span></em></>
          )}
          , <span lang="cy">{c.ward_cy}</span><span lang="en">{c.ward_en}</span>
        </li>
      ))}
    </ul>

    <p lang="cy">I weld cofrestr buddiannau unigol aelod, cysylltwch â'r Clerc drwy'r <a href="/contact/">dudalen gyswllt</a>.</p>
    <p lang="en">To see an individual member's register of interests, contact the Clerk via the <a href="/contact/">contact page</a>.</p>

    <p>
      <a href="/documents/code-of-conduct/"><span lang="cy">Côd Ymddygiad →</span><span lang="en">Code of Conduct →</span></a>
    </p>
  </div></div>
</Layout>
