    const villages = [
      { lat: 53.17976, lng: -3.59841, label: 'Llansannan<br>LL16 5HE' },
      { lat: 53.15336, lng: -3.53274, label: 'Bylchau' }
    ];
    villages.forEach(v => {
      L.marker([v.lat, v.lng], { icon: villageIcon })
