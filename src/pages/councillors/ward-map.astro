    // settlements the council covers. Coordinates are each village's
    // actual centre (checked against independent sources), not the old
    // placeholder point that had Llansannan's marker sitting outside the
    // village itself.
    const villageIcon = L.divIcon({
      className: '',
      html: '<div style="background:#b07420;width:16px;height:16px;border-radius:50%;border:3px solid #fff;box-shadow:0 1px 6px rgba(0,0,0,0.45)"></div>',
