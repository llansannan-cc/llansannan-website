---
import Layout from '../../layouts/Layout.astro';
import meetings from '../../data/meetings.json';
import events from '../../data/events.json';
import { monthNamesEn, monthNamesCy, formatDateBilingual } from '../../lib/dates';

type CalItem = {
  iso: string;
  kind: 'meeting' | 'event';
  time: string;
  status: string;
  label_cy: string;
  label_en: string;
  date_cy?: string;
  date_en?: string;
  location_cy?: string;
  location_en?: string;
  description_cy?: string;
  description_en?: string;
};

const meetingItems: CalItem[] = meetings.schedule_2026.map((m): CalItem => {
  const { cy: date_cy, en: date_en } = formatDateBilingual(m.date);
  return {
    iso: m.date, kind: 'meeting', time: m.time, status: m.status,
    label_cy: m.type_cy, label_en: m.type_en,
    date_cy, date_en
  };
});

const eventItems: CalItem[] = events.items.map((e): CalItem => ({
  iso: e.date, kind: 'event', time: e.time || '', status: '',
  label_cy: e.title_cy, label_en: e.title_en,
  location_cy: e.location_cy, location_en: e.location_en,
  description_cy: e.description_cy || '', description_en: e.description_en || ''
}));

// One merged, sorted feed of council meetings and community events.
const calendarItems = [...meetingItems, ...eventItems].sort((a, b) => a.iso.localeCompare(b.iso));

const todayIso = new Date().toISOString().slice(0, 10);
const upcomingItems = calendarItems.filter(it => it.iso >= todayIso);

// Build a month's grid: a Monday-first array of day numbers (null = padding
// before the 1st), plus a lookup of items by day-of-month.
function buildMonthGrid(year: number, month: number) {
  const first = new Date(year, month, 1);
  const startOffset = (first.getDay() + 6) % 7;
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const byDay: Record<number, CalItem[]> = {};
  calendarItems.forEach(it => {
    const d = new Date(it.iso + 'T00:00:00');
    if (d.getFullYear() === year && d.getMonth() === month) {
      (byDay[d.getDate()] ||= []).push(it);
    }
  });
  const cells: (number | null)[] = [];
  for (let i = 0; i < startOffset; i++) cells.push(null);
  for (let day = 1; day <= daysInMonth; day++) cells.push(day);
  return { cells, byDay };
}

// Rendered server-side for the current month so the calendar works with no
// JavaScript; the client script takes over month navigation from there.
// Rebuilt daily by the scheduled rebuild, so "this month" stays current
// without a new commit.
const now = new Date();
const initialYear = now.getFullYear();
const initialMonth = now.getMonth();
const { cells, byDay } = buildMonthGrid(initialYear, initialMonth);

const weekdayLabels_en = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
const weekdayLabels_cy = ['Llun','Maw','Mer','Iau','Gwe','Sad','Sul'];
const monthLabel_en = `${monthNamesEn[initialMonth]} ${initialYear}`;
const monthLabel_cy = `${monthNamesCy[initialMonth]} ${initialYear}`;
---
<Layout title_cy="Calendr" title_en="Calendar">
  <div class="page-banner"><h1><span lang="cy">Calendr Cymunedol</span><span lang="en">Community Calendar</span></h1></div>
  <div class="breadcrumb"><a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo; <span lang="cy">Calendr</span><span lang="en">Calendar</span></div>
  <div class="site-wrap"><div class="content" data-pagefind-body>
    <h2 class="sh"><span lang="cy">Calendr</span><span lang="en">Calendar</span></h2><hr class="sh-rule">

    <p lang="cy">Un calendr ar gyfer cyfarfodydd y cyngor a digwyddiadau cymunedol.</p>
    <p lang="en">One calendar for council meetings and community events.</p>

    <div class="cal-layout">
      <div class="cal-grid-wrap">
        <div class="cal-grid-head">
          <button type="button" id="calPrev" class="cal-nav-btn" aria-label="Previous month">&lsaquo;</button>
          <span class="cal-grid-month"><span lang="en" id="calMonthLabelEn">{monthLabel_en}</span><span lang="cy" id="calMonthLabelCy">{monthLabel_cy}</span></span>
          <button type="button" id="calNext" class="cal-nav-btn" aria-label="Next month">&rsaquo;</button>
        </div>
        <div class="cal-grid-weekdays">
          {weekdayLabels_en.map((w, i) => (
            <div><span lang="en">{w}</span><span lang="cy">{weekdayLabels_cy[i]}</span></div>
          ))}
        </div>
        <div class="cal-grid" id="calGrid" data-year={initialYear} data-month={initialMonth}>
          {cells.map(day => {
            if (day === null) return <div class="cal-cell cal-cell-pad"></div>;
            const dayItems = byDay[day] || [];
            const isoDay = `${initialYear}-${String(initialMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            const isToday = isoDay === todayIso;
            const first = dayItems[0];
            return (
              <div
                class:list={['cal-cell', dayItems.length > 0 && 'has-items', isToday && 'is-today']}
                data-day={day}
                tabindex="0"
                role="button"
                aria-label={`${day}${dayItems.length > 0 ? `, ${dayItems.length} item${dayItems.length > 1 ? 's' : ''}` : ''}`}
              >
                <span class="cal-cell-num">{day}</span>
                {first && (
                  <span class:list={['cal-cell-label', first.kind === 'event' && 'cal-cell-label-event']}>
                    {first.kind === 'meeting' ? (
                      first.time
                    ) : (
                      <>
                        <span lang="cy">{first.label_cy}</span>
                        <span lang="en">{first.label_en}</span>
                      </>
                    )}
                  </span>
                )}
                {dayItems.length > 1 && <span class="cal-cell-more">+{dayItems.length - 1}</span>}
              </div>
            );
          })}
        </div>
        <p class="cal-legend">
          <span><span class="cal-dot cal-dot-meeting"></span><span lang="cy">Cyfarfod cyngor</span><span lang="en">Council meeting</span></span>
          <span><span class="cal-dot cal-dot-event"></span><span lang="cy">Digwyddiad cymunedol</span><span lang="en">Community event</span></span>
        </p>
      </div>
      <div class="cal-detail-panel" id="calDetail" aria-live="polite">
        <p class="cal-detail-empty" lang="cy">Cyffyrddwch â diwrnod i weld manylion.</p>
        <p class="cal-detail-empty" lang="en">Tap a day to see details.</p>
      </div>
    </div>

    <script define:vars={{ allItems: calendarItems, monthNamesEn, monthNamesCy, todayIso }}>
      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      var grid = document.getElementById('calGrid');
      var monthLabelEn = document.getElementById('calMonthLabelEn');
      var monthLabelCy = document.getElementById('calMonthLabelCy');
      var panel = document.getElementById('calDetail');
      var state = { year: parseInt(grid.dataset.year, 10), month: parseInt(grid.dataset.month, 10) };

      function itemsByDay(year, month) {
        var byDay = {};
        allItems.forEach(function (it) {
          var d = new Date(it.iso + 'T00:00:00');
          if (d.getFullYear() === year && d.getMonth() === month) {
            var day = d.getDate();
            if (!byDay[day]) byDay[day] = [];
            byDay[day].push(it);
          }
        });
        return byDay;
      }

      function cellHtml(day, items, year, month) {
        if (day === null) return '<div class="cal-cell cal-cell-pad"></div>';
        var isoDay = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
        var isToday = isoDay === todayIso;
        var cls = 'cal-cell' + (items.length > 0 ? ' has-items' : '') + (isToday ? ' is-today' : '');
        var first = items[0];
        var labelHtml = '';
        if (first) {
          var labelCls = 'cal-cell-label' + (first.kind === 'event' ? ' cal-cell-label-event' : '');
          labelHtml = first.kind === 'meeting'
            ? '<span class="' + labelCls + '">' + escapeHtml(first.time) + '</span>'
            : '<span class="' + labelCls + '"><span lang="cy">' + escapeHtml(first.label_cy) + '</span><span lang="en">' + escapeHtml(first.label_en) + '</span></span>';
        }
        var moreHtml = items.length > 1 ? '<span class="cal-cell-more">+' + (items.length - 1) + '</span>' : '';
        var label = day + (items.length ? ', ' + items.length + ' item' + (items.length > 1 ? 's' : '') : '');
        return '<div class="' + cls + '" data-day="' + day + '" tabindex="0" role="button" aria-label="' + label + '">' +
          '<span class="cal-cell-num">' + day + '</span>' + labelHtml + moreHtml + '</div>';
      }

      function renderDetail(items) {
        if (!items || !items.length) {
          panel.innerHTML =
            '<p class="cal-detail-empty" lang="cy">Dim byd wedi’i drefnu’r mis hwn.</p>' +
            '<p class="cal-detail-empty" lang="en">Nothing scheduled this month.</p>';
          return;
        }
        panel.innerHTML = items.map(function (it) {
          var titleCy = escapeHtml(it.label_cy);
          var titleEn = escapeHtml(it.label_en);
          var metaEn = it.kind === 'meeting'
            ? escapeHtml(it.date_en) + ' &middot; ' + escapeHtml(it.time)
            : (it.time ? escapeHtml(it.time) + ' &middot; ' : '') + escapeHtml(it.location_en);
          var metaCy = it.kind === 'meeting'
            ? escapeHtml(it.date_cy) + ' &middot; ' + escapeHtml(it.time)
            : (it.time ? escapeHtml(it.time) + ' &middot; ' : '') + escapeHtml(it.location_cy);
          return (
            '<div class="cal-detail-item">' +
              '<span class="cal-detail-dot cal-dot-' + it.kind + '"></span>' +
              '<div>' +
                '<div class="cal-detail-title"><span lang="cy">' + titleCy + '</span><span lang="en">' + titleEn + '</span></div>' +
                '<div class="cal-detail-meta"><span lang="cy">' + metaCy + '</span><span lang="en">' + metaEn + '</span></div>' +
              '</div>' +
            '</div>'
          );
        }).join('');
      }

      function pickDefaultDay(year, month, byDay) {
        var todayDate = new Date(todayIso + 'T00:00:00');
        if (todayDate.getFullYear() === year && todayDate.getMonth() === month && (byDay[todayDate.getDate()] || []).length) {
          return todayDate.getDate();
        }
        var days = Object.keys(byDay).map(Number).sort(function (a, b) { return a - b; });
        for (var k = 0; k < days.length; k++) {
          var iso = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(days[k]).padStart(2, '0');
          if (iso >= todayIso) return days[k];
        }
        return null;
      }

      function renderMonth(year, month) {
        var first = new Date(year, month, 1);
        var startOffset = (first.getDay() + 6) % 7;
        var daysInMonth = new Date(year, month + 1, 0).getDate();
        var byDay = itemsByDay(year, month);
        var html = '';
        for (var i = 0; i < startOffset; i++) html += cellHtml(null, [], year, month);
        for (var day = 1; day <= daysInMonth; day++) html += cellHtml(day, byDay[day] || [], year, month);
        grid.innerHTML = html;
        grid.dataset.year = year;
        grid.dataset.month = month;
        monthLabelEn.textContent = monthNamesEn[month] + ' ' + year;
        monthLabelCy.textContent = monthNamesCy[month] + ' ' + year;

        var selectDay = pickDefaultDay(year, month, byDay);
        if (selectDay) {
          var cell = grid.querySelector('.cal-cell[data-day="' + selectDay + '"]');
          if (cell) cell.classList.add('is-selected');
          renderDetail(byDay[selectDay] || []);
        } else {
          renderDetail([]);
        }
      }

      grid.addEventListener('click', function (e) {
        var cell = e.target.closest('.cal-cell[data-day]');
        if (!cell) return;
        var day = parseInt(cell.dataset.day, 10);
        var byDay = itemsByDay(state.year, state.month);
        grid.querySelectorAll('.cal-cell.is-selected').forEach(function (c) { c.classList.remove('is-selected'); });
        cell.classList.add('is-selected');
        renderDetail(byDay[day] || []);
      });
      grid.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        var cell = e.target.closest('.cal-cell[data-day]');
        if (!cell) return;
        e.preventDefault();
        cell.click();
      });

      document.getElementById('calPrev').addEventListener('click', function () {
        state.month -= 1;
        if (state.month < 0) { state.month = 11; state.year -= 1; }
        renderMonth(state.year, state.month);
      });
      document.getElementById('calNext').addEventListener('click', function () {
        state.month += 1;
        if (state.month > 11) { state.month = 0; state.year += 1; }
        renderMonth(state.year, state.month);
      });

      // Refresh the server-rendered current month through the same code path,
      // so selection state and markup stay consistent with navigated months.
      renderMonth(state.year, state.month);
    </script>

    <div class="cal-list-fallback">
      <h3 class="sub-sh"><span lang="cy">I Ddod</span><span lang="en">Coming up</span></h3>
      {upcomingItems.length === 0 ? (
        <>
          <p lang="cy">Nid oes dim wedi'i drefnu ar hyn o bryd.</p>
          <p lang="en">Nothing is currently scheduled.</p>
        </>
      ) : (
        <div class="cal-list">
          {upcomingItems.map(it => {
            const d = new Date(it.iso + 'T00:00:00');
            const dayNum = d.getDate();
            const monthShort = d.toLocaleString('en-GB', { month: 'short' });
            return (
              <div class="cal-item">
                <div class:list={['cal-date-box', it.kind === 'event' && 'cal-date-box-event']}>
                  <div class="cal-day">{dayNum}</div>
                  <div class="cal-month">{monthShort}</div>
                </div>
                <div>
                  <div class="cal-title">
                    <span lang="cy">{it.label_cy}</span>
                    <span lang="en">{it.label_en}</span>
                    {it.status === 'next' && <strong> — <span lang="cy">Nesaf</span><span lang="en">Next</span></strong>}
                  </div>
                  <div class="cal-detail">
                    {it.kind === 'meeting' ? (
                      <><span lang="cy">{it.date_cy}</span><span lang="en">{it.date_en}</span>{' · '}{it.time}</>
                    ) : (
                      <>{it.time && <>{it.time}{' · '}</>}<span lang="cy">{it.location_cy}</span><span lang="en">{it.location_en}</span></>
                    )}
                  </div>
                  {it.kind === 'event' && (it.description_cy || it.description_en) && (
                    <p class="cal-desc">
                      <span lang="cy">{it.description_cy}</span>
                      <span lang="en">{it.description_en}</span>
                    </p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    <p style="margin-top:1rem"><a href="/meetings/"><span lang="cy">Gweld pob cyfarfod →</span><span lang="en">View all meetings →</span></a></p>
  </div></div>
</Layout>
