---
import Layout from '../../layouts/Layout.astro';
import agendas from '../../data/agendas.json';
import settings from '../../data/site-settings.json';

const withAgendas = agendas.items
  .filter(m => m.agenda_en_file || m.agenda_cy_file)
  .sort((a, b) => b.meeting_date.localeCompare(a.meeting_date));
const years = [...new Set(withAgendas.map(m => m.meeting_date.slice(0, 4)))];
---
<Layout title_cy="Agendâu" title_en="Agendas">
  <div class="page-banner">
    <h1><span lang="cy">Agendâu</span><span lang="en">Agendas</span></h1>
  </div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <a href="/meetings/"><span lang="cy">Cyfarfodydd</span><span lang="en">Meetings</span></a> &rsaquo;
    <span lang="cy">Agendâu</span><span lang="en">Agendas</span>
  </div>
  <div class="site-wrap"><div class="content">
    <h2 class="sh"><span lang="cy">Agendâu Cyfarfodydd</span><span lang="en">Meeting Agendas</span></h2>
    <hr class="sh-rule">

    <div class="notice">
      <span lang="cy">Cyhoeddir agendâu o leiaf deuddeng diwrnod cyn pob cyfarfod.</span>
      <span lang="en">Agendas are published at least three clear days before each meeting.</span>
    </div>

    {withAgendas.length > 0 ? (
      <div class="minutes-list">
        {years.map(y => (
          <>
            <h3 class="sub-sh" id={`y${y}`}>{y}</h3>
            {withAgendas.filter(m => m.meeting_date.startsWith(y)).map(m => (
              <article class="minutes-item" data-pagefind-body>
                <h3>
                  <span lang="cy">{m.meeting_type_cy} — {m.meeting_date}</span>
                  <span lang="en">{m.meeting_type_en} — {m.meeting_date}</span>
                </h3>
                <ul class="doc-links">
                  {m.agenda_en_file && m.agenda_en_file === m.agenda_cy_file ? (
                    <li><a href={m.agenda_en_file} class="doc-link pdf"><span lang="cy">Agenda (dwyieithog) — PDF</span><span lang="en">Agenda (bilingual) — PDF</span></a></li>
                  ) : (<>
                    {m.agenda_en_file && <li><a href={m.agenda_en_file} lang="en" class="doc-link pdf">Agenda (English) — PDF</a></li>}
                    {m.agenda_cy_file && <li><a href={m.agenda_cy_file} lang="cy" class="doc-link pdf">Agenda (Cymraeg) — PDF</a></li>}
                  </>)}
                </ul>
              </article>
            ))}
          </>
        ))}
      </div>
    ) : (
      <p lang="cy">Nid oes agendâu wedi'u cyhoeddi ar hyn o bryd.</p>
      <p lang="en">No agendas have been published at this time.</p>
    )}

    <section class="upload-note">
      <h3>
        <span lang="cy">Mynediad at Agendâu</span>
        <span lang="en">Accessing Agendas</span>
      </h3>
      <p lang="cy">Os na allwch gael mynediad at agenda, cysylltwch â'r Clerc: <a href={`mailto:${settings.council.clerk_email_cy}`}>{settings.council.clerk_email_cy}</a></p>
      <p lang="en">If you cannot access an agenda, please contact the Clerk: <a href={`mailto:${settings.council.clerk_email}`}>{settings.council.clerk_email}</a></p>
    </section>
  </div></div>
</Layout>
