---
import Layout from '../../layouts/Layout.astro';
import meetings from '../../data/meetings.json';
import settings from '../../data/site-settings.json';
import { formatDateBilingual } from '../../lib/dates';
import { computeStatuses } from '../../lib/meetings';

const scheduled = computeStatuses(meetings.schedule_2026);
const yearShown = (scheduled.find(m => m.status === 'next') ?? scheduled[scheduled.length - 1])?.date.slice(0, 4) ?? '';
---
<Layout title_cy="Dyddiadau Cyfarfodydd" title_en="Meeting Dates">
  <div class="page-banner">
    <h1><span lang="cy">Dyddiadau Cyfarfodydd</span><span lang="en">Meeting Dates</span></h1>
  </div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <span lang="cy">Cyfarfodydd</span><span lang="en">Meetings</span>
  </div>
  <div class="site-wrap"><div class="content">
    <h2 class="sh"><span lang="cy">Cyfarfodydd {yearShown}</span><span lang="en">{yearShown} Meetings</span></h2>
    <hr class="sh-rule">

    <div class="notice">
      <span lang="cy">Mae pob cyfarfod yn agored i'r cyhoedd. Gall y lleoliad newid - gwiriwch y tabl.</span>
      <span lang="en">All meetings are open to the public. The venue can change, so please check the table.</span>
    </div>

    <table class="mtg-table" aria-label="Meeting dates / Dyddiadau cyfarfodydd">
      <thead>
        <tr>
          <th lang="cy">Dyddiad</th><th lang="en">Date</th>
          <th lang="cy">Math</th><th lang="en">Type</th>
          <th lang="cy">Amser</th><th lang="en">Time</th>
          <th lang="cy">Lleoliad</th><th lang="en">Venue</th>
        </tr>
      </thead>
      <tbody>
        {scheduled.map(m => {
          const { cy: dateCy, en: dateEn } = formatDateBilingual(m.date);
          return (
          <tr class={m.status === 'next' ? 'next-row' : ''} data-end={m.end}>
            <td>
              <span lang="cy">{dateCy}</span>
              <span lang="en">{dateEn}</span>
              <strong class="nm-badge" hidden={m.status !== 'next'}> ◀ <span lang="cy">Nesaf</span><span lang="en">Next</span></strong>
            </td>
            <td>
              <span lang="cy">{m.type_cy}</span>
              <span lang="en">{m.type_en}</span>
            </td>
            <td>{m.time}</td>
            <td>
              <span lang="cy">{m.location_cy || "I'w gadarnhau"}</span>
              <span lang="en">{m.location_en || 'To be confirmed'}</span>
            </td>
          </tr>
          );
        })}
      </tbody>
    </table>

    <p style="margin-top:1.5rem;font-size:0.85rem">
      <span lang="cy">Am ragor o wybodaeth cysylltwch â'r Clerc: <a href={`mailto:${settings.council.clerk_email_cy}`}>{settings.council.clerk_email_cy}</a></span>
      <span lang="en">For further information contact the Clerk: <a href={`mailto:${settings.council.clerk_email}`}>{settings.council.clerk_email}</a></span>
    </p>
  </div></div>
</Layout>
