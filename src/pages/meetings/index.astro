---
import Layout from '../../layouts/Layout.astro';
import meetings from '../../data/meetings.json';
import settings from '../../data/site-settings.json';
import { formatDateBilingual } from '../../lib/dates';
---
<Layout title_cy="Dyddiadau Cyfarfodydd" title_en="Meeting Dates">
  <div class="page-banner">
    <h1><span lang="cy">Dyddiadau Cyfarfodydd</span><span lang="en">Meeting Dates</span></h1>
  </div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <span lang="cy">Cyfarfodydd</span><span lang="en">Meetings</span>
  </div>
  <div class="site-wrap"><div class="content">
    <h2 class="sh"><span lang="cy">Cyfarfodydd 2026</span><span lang="en">2026 Meetings</span></h2>
    <hr class="sh-rule">

    <div class="notice">
      <span lang="cy">Cynhelir cyfarfodydd yn {settings.meeting_defaults.location_cy}. Mae pob cyfarfod yn agored i'r cyhoedd.</span>
      <span lang="en">Meetings are held at {settings.meeting_defaults.location_en}. All meetings are open to the public.</span>
    </div>

    <table class="mtg-table" aria-label="Meeting dates / Dyddiadau cyfarfodydd">
      <thead>
        <tr>
          <th lang="cy">Dyddiad</th><th lang="en">Date</th>
          <th lang="cy">Math</th><th lang="en">Type</th>
          <th lang="cy">Amser</th><th lang="en">Time</th>
        </tr>
      </thead>
      <tbody>
        {meetings.schedule_2026.map(m => {
          const { cy: dateCy, en: dateEn } = formatDateBilingual(m.date);
          return (
          <tr class={m.status === 'next' ? 'next-row' : ''}>
            <td>
              <span lang="cy">{dateCy}</span>
              <span lang="en">{dateEn}</span>
              {m.status === 'next' && <strong> ◀ <span lang="cy">Nesaf</span><span lang="en">Next</span></strong>}
            </td>
            <td>
              <span lang="cy">{m.type_cy}</span>
              <span lang="en">{m.type_en}</span>
            </td>
            <td>{m.time}</td>
          </tr>
          );
        })}
      </tbody>
    </table>

    <p style="margin-top:1.5rem;font-size:0.85rem">
      <span lang="cy">Am ragor o wybodaeth cysylltwch â'r Clerc: <a href={`mailto:${settings.council.email}`}>{settings.council.email}</a></span>
      <span lang="en">For further information contact the Clerk: <a href={`mailto:${settings.council.email}`}>{settings.council.email}</a></span>
    </p>
  </div></div>
</Layout>
