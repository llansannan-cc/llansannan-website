---
import Layout from '../../layouts/Layout.astro';
import documents from '../../data/documents.json';
import DocLinks from '../../components/DocLinks.astro';
---
<Layout title_cy="Canllaw Cyfryngau Cymdeithasol" title_en="Social Media Guidelines">
  <div class="page-banner"><h1><span lang="cy">Canllawiau Cyfryngau Cymdeithasol</span><span lang="en">Social Media Guidelines</span></h1></div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <a href="/documents/"><span lang="cy">Dogfennau</span><span lang="en">Documents</span></a> &rsaquo;
    <span lang="cy">Cyfryngau Cymdeithasol</span><span lang="en">Social Media</span>
  </div>
  <div class="site-wrap"><div class="content" data-pagefind-body>
    <h2 class="sh"><span lang="cy">Canllaw Cyfryngau Cymdeithasol ar gyfer Aelodau</span><span lang="en">Social Media Guidelines for Members</span></h2><hr class="sh-rule">

    <p lang="cy">Mae'r canllawiau hyn yn helpu aelodau'r cyngor i ddefnyddio cyfryngau cymdeithasol mewn ffordd sy'n briodol ac sy'n parchu'r Côd Ymddygiad.</p>
    <p lang="en">These guidelines help council members use social media in a way that is appropriate and consistent with the Code of Conduct.</p>

    <h3 class="sub-sh"><span lang="cy">Egwyddorion allweddol</span><span lang="en">Key principles</span></h3>
    <ul lang="cy">
      <li>Cydnabyddwch pan fyddwch yn siarad yn eich rhinwedd bersonol, nid fel cynrychiolydd y cyngor</li>
      <li>Peidiwch â rhannu gwybodaeth gyfrinachol am drafodaethau'r cyngor</li>
      <li>Cofiwch fod unrhyw beth a bostiwch ar-lein yn gallu aros yno am byth</li>
      <li>Peidiwch â defnyddio iaith ymosodol na gwneud honiadau difenwol</li>
      <li>Parchwch breifatrwydd trigolion a chydgynghorwyr</li>
    </ul>
    <ul lang="en">
      <li>Acknowledge when you are speaking in a personal capacity, not as a council representative</li>
      <li>Do not share confidential information about council discussions</li>
      <li>Remember that anything posted online can remain there permanently</li>
      <li>Do not use offensive language or make defamatory claims</li>
      <li>Respect the privacy of residents and fellow councillors</li>
    </ul>

    <div class="minutes-list" style="margin-top:1.5rem">
      <div class="minutes-item">
        <div>
          <strong><span lang="cy">Polisi Cyfryngau Cymdeithasol — yn cael ei adolygu</span><span lang="en">Social Media Policy — under review</span></strong>
          <div class="fg-meta"><span lang="cy">Fersiwn bresennol</span><span lang="en">Current version</span></div>
        </div>
        <DocLinks doc={documents.social_media} />
      </div>
    </div>

    <p style="margin-top:1.5rem"><a href="/documents/code-of-conduct/"><span lang="cy">Gweld y Côd Ymddygiad →</span><span lang="en">View the Code of Conduct →</span></a></p>
  </div></div>
</Layout>
