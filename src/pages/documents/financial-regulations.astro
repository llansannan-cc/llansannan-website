---
import Layout from '../../layouts/Layout.astro';
import documents from '../../data/documents.json';
import DocLinks from '../../components/DocLinks.astro';
---
<Layout title_cy="Rheoliadau Ariannol" title_en="Financial Regulations">
  <div class="page-banner"><h1><span lang="cy">Rheoliadau Ariannol</span><span lang="en">Financial Regulations</span></h1></div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <a href="/documents/"><span lang="cy">Dogfennau</span><span lang="en">Documents</span></a> &rsaquo;
    <span lang="cy">Rheoliadau Ariannol</span><span lang="en">Financial Regulations</span>
  </div>
  <div class="site-wrap"><div class="content" data-pagefind-body>
    <h2 class="sh"><span lang="cy">Rheoliadau Ariannol</span><span lang="en">Financial Regulations</span></h2><hr class="sh-rule">

    <p lang="cy">Mae Rheoliadau Ariannol yn pennu'r fframwaith ar gyfer rheoli cyllid Cyngor Cymuned Llansannan. Maent yn sicrhau bod arian cyhoeddus yn cael ei ddefnyddio'n briodol ac yn atebol.</p>
    <p lang="en">Financial Regulations set out the framework for managing the finances of Llansannan Community Council. They ensure that public money is used appropriately and accountably.</p>

    <div class="minutes-list">
      <div class="minutes-item">
        <div>
          <strong><span lang="cy">Rheoliadau Ariannol — yn cael eu hadolygu</span><span lang="en">Financial Regulations — under review</span></strong>
          <div class="fg-meta"><span lang="cy">Fersiwn bresennol</span><span lang="en">Current version</span></div>
        </div>
        <DocLinks doc={documents.financial_regulations} />
      </div>
    </div>

    <div class="upload-note" style="margin-top:1.5rem">
      <p lang="cy">I gael copi o'r Rheoliadau Ariannol, cysylltwch â'r Clerc.</p>
      <p lang="en">To obtain a copy of the Financial Regulations, please contact the Clerk.</p>
    </div>
    <p>
      <a href="/the-council/clerk/"><span lang="cy">Manylion y Clerc →</span><span lang="en">Clerk's contact details →</span></a>
      &nbsp;&nbsp;
      <a href="/the-council/what-we-spend/"><span lang="cy">Beth rydym yn ei wario →</span><span lang="en">What we spend →</span></a>
    </p>
  </div></div>
</Layout>
