---
import Layout from '../../layouts/Layout.astro';
---
<Layout title_cy="Dogfennau" title_en="Documents">
  <div class="page-banner"><h1><span lang="cy">Dogfennau</span><span lang="en">Documents</span></h1></div>
  <div class="breadcrumb"><a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo; <span lang="cy">Dogfennau</span><span lang="en">Documents</span></div>
  <div class="site-wrap"><div class="content">
    <h2 class="sh"><span lang="cy">Dogfennau'r Cyngor</span><span lang="en">Council Documents</span></h2><hr class="sh-rule">

    <p lang="cy">Mae'r adran hon yn cynnwys polisïau, rheolau a dogfennau swyddogol Cyngor Cymuned Llansannan.</p>
    <p lang="en">This section contains the policies, rules and official documents of Llansannan Community Council.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;margin:1.5rem 0">
      <a href="/documents/standing-orders/" class="qa-card">
        <div class="qa-label"><span lang="cy">Rheolau Sefydlog</span><span lang="en">Standing Orders</span></div>
        <div class="qa-desc"><span lang="cy">Rheolau gweithdrefnol y cyngor</span><span lang="en">The council's procedural rules</span></div>
      </a>
      <a href="/documents/financial-regulations/" class="qa-card">
        <div class="qa-label"><span lang="cy">Rheoliadau Ariannol</span><span lang="en">Financial Regulations</span></div>
        <div class="qa-desc"><span lang="cy">Rheolaeth ariannol y cyngor</span><span lang="en">The council's financial management</span></div>
      </a>
      <a href="/documents/code-of-conduct/" class="qa-card">
        <div class="qa-label"><span lang="cy">Côd Ymddygiad</span><span lang="en">Code of Conduct</span></div>
        <div class="qa-desc"><span lang="cy">Ymddygiad disgwyliedig aelodau</span><span lang="en">Expected behaviour of members</span></div>
      </a>
      <a href="/documents/nolan-principles/" class="qa-card">
        <div class="qa-label"><span lang="cy">Egwyddorion Nolan</span><span lang="en">Nolan Principles</span></div>
        <div class="qa-desc"><span lang="cy">Saith egwyddor bywyd cyhoeddus</span><span lang="en">Seven principles of public life</span></div>
      </a>
      <a href="/documents/biodiversity/" class="qa-card">
        <div class="qa-label"><span lang="cy">Bioamrywiaeth</span><span lang="en">Biodiversity</span></div>
        <div class="qa-desc"><span lang="cy">Polisi bioamrywiaeth y cyngor</span><span lang="en">The council's biodiversity policy</span></div>
      </a>
      <a href="/documents/social-media/" class="qa-card">
        <div class="qa-label"><span lang="cy">Canllaw Cyfryngau Cymdeithasol</span><span lang="en">Social Media Guide</span></div>
        <div class="qa-desc"><span lang="cy">Canllawiau ar gyfer aelodau</span><span lang="en">Guidelines for members</span></div>
      </a>
      <a href="/documents/archive/" class="qa-card">
        <div class="qa-label"><span lang="cy">Archif Dogfennau</span><span lang="en">Document Archive</span></div>
        <div class="qa-desc"><span lang="cy">Cofrestrau, adroddiadau a hysbysiadau</span><span lang="en">Registers, reports and notices</span></div>
      </a>
    </div>

    <h3 class="sub-sh"><span lang="cy">Cofnodion a Chyfrifon</span><span lang="en">Minutes &amp; Accounts</span></h3>
    <p>
      <a href="/meetings/minutes/" class="btn" style="margin-right:0.5rem">
        <span lang="cy">Cofnodion →</span><span lang="en">Minutes →</span>
      </a>
      <a href="/the-council/annual-return/" class="btn btn-outline">
        <span lang="cy">Ffurflen Flynyddol →</span><span lang="en">Annual Return →</span>
      </a>
    </p>
  </div></div>
</Layout>
