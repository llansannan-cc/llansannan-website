---
import Layout from '../../layouts/Layout.astro';
import councillors from '../../data/councillors.json';
import { ROLE_LABELS } from '../../data/people-lookups.js';

const totalCouncillors = councillors.people.filter(p => p.active && p.ward !== 'staff').length;
const chairPerson = councillors.people.find(p => p.role === 'chair' && p.active);
const clerkPerson = councillors.people.find(p => p.role === 'clerk' && p.active);
---
<Layout title_cy="Am y Cyngor" title_en="About the Council">
  <div class="page-banner">
    <h1><span lang="cy">Y Cyngor</span><span lang="en">The Council</span></h1>
  </div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <span lang="cy">Y Cyngor</span><span lang="en">The Council</span>
  </div>
  <div class="site-wrap"><div class="content">
    <h2 class="sh"><span lang="cy">Am Gyngor Cymuned Llansannan</span><span lang="en">About Llansannan Community Council</span></h2>
    <hr class="sh-rule">

    <p lang="cy">Mae Cyngor Cymuned Llansannan yn haen gyntaf llywodraeth leol sy'n gwasanaethu ardal Bro Aled yng Nghonwy. Mae'n cynrychioli cymunedau Llansannan, Bylchau a Llannefydd.</p>
    <p lang="en">Llansannan Community Council is the first tier of local government serving the Bro Aled area of Conwy County Borough. It represents the communities of Llansannan, Bylchau and Llannefydd.</p>

    <h3 class="sub-sh"><span lang="cy">Cadeirydd</span><span lang="en">Chair</span></h3>
    <p lang="cy">Y {ROLE_LABELS.chair.cy} presennol yw y Cynghorydd <strong>{chairPerson?.name}</strong>.</p>
    <p lang="en">The current {ROLE_LABELS.chair.en} is Councillor <strong>{chairPerson?.name}</strong>.</p>

    <h3 class="sub-sh"><span lang="cy">Y Clerc</span><span lang="en">The Clerk</span></h3>
    <p lang="cy">Y prif swyddog yw'r Clerc — <strong>{clerkPerson?.name}</strong>. Mae'r Clerc yn gyfrifol am gynghori'r cyngor, cymryd cofnodion a sicrhau cydymffurfiaeth. <a href="/the-council/clerk/">Mwy am y Clerc →</a></p>
    <p lang="en">The principal officer is the Clerk — <strong>{clerkPerson?.name}</strong>. The Clerk is responsible for advising the council, taking minutes and ensuring compliance. <a href="/the-council/clerk/">More about the Clerk →</a></p>

    <h3 class="sub-sh"><span lang="cy">Aelodaeth</span><span lang="en">Membership</span></h3>
    <p lang="cy">Mae gan y cyngor {totalCouncillors} aelod ar hyn o bryd, gyda rhai swyddi gwag yn Ward Llannefydd. Mae pob aelod wedi'i gyd-optio. <a href="/councillors/">Gweld eich cynghorwyr →</a></p>
    <p lang="en">The council currently has {totalCouncillors} members, with some vacancies in Llannefydd Ward. All members are co-opted. <a href="/councillors/">View your councillors →</a></p>

    <h3 class="sub-sh"><span lang="cy">Cyfarfodydd</span><span lang="en">Meetings</span></h3>
    <p lang="cy">Mae'r cyngor yn cwrdd bob mis ac mae'r cyfarfodydd yn agored i'r cyhoedd. <a href="/meetings/">Gweld dyddiadau cyfarfodydd →</a></p>
    <p lang="en">The council meets monthly and all meetings are open to the public. <a href="/meetings/">View meeting dates →</a></p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;margin:2rem 0">
      <a href="/the-council/what-we-do/" class="qa-card">
        <div class="qa-label"><span lang="cy">Beth Rydym yn ei Wneud</span><span lang="en">What We Do</span></div>
        <div class="qa-desc"><span lang="cy">Cyfrifoldebau ac awdurdodaeth</span><span lang="en">Responsibilities and powers</span></div>
      </a>
      <a href="/the-council/grants/" class="qa-card">
        <div class="qa-label"><span lang="cy">Grantiau a Rhoddion</span><span lang="en">Grants &amp; Donations</span></div>
        <div class="qa-desc"><span lang="cy">Cyllid ar gyfer grwpiau lleol</span><span lang="en">Funding for local groups</span></div>
      </a>
      <a href="/the-council/what-we-spend/" class="qa-card">
        <div class="qa-label"><span lang="cy">Beth Rydym yn ei Wario</span><span lang="en">What We Spend</span></div>
        <div class="qa-desc"><span lang="cy">Cyllideb a gwariant</span><span lang="en">Budget and expenditure</span></div>
      </a>
      <a href="/the-council/clerk/" class="qa-card">
        <div class="qa-label"><span lang="cy">Ein Clerc</span><span lang="en">Our Clerk</span></div>
        <div class="qa-desc"><span lang="cy">Cysylltu â'r swyddfa</span><span lang="en">Contact the office</span></div>
      </a>
    </div>
  </div></div>
</Layout>
